<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VoipClient.ChatWindow"
        Title="Chat" Height="560" Width="700"
        MinWidth="550" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130" MinWidth="90"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: rooms -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock FontWeight="Bold" Margin="0,0,0,4" Text="🔊 Voice Rooms"/>
            <ListBox Name="VoiceRoomList" Height="100"
                     DoubleTapped="VoiceRoom_DoubleTapped"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu Name="VoiceRoomContextMenu" Opening="VoiceRoomContextMenu_Opening"/>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Name="LeaveVoiceBtn" Content="Leave Voice" Margin="0,4,0,0"
                    Click="LeaveVoice_Click" IsEnabled="False"/>

            <TextBlock FontWeight="Bold" Margin="0,14,0,4" Text="💬 Text Rooms"/>
            <ListBox Name="TextRoomList" Height="200"
                     SelectionChanged="TextRoom_SelectionChanged"
                     DoubleTapped="TextRoom_DoubleTapped"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Center: chat OR video (toggled) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Click="Settings_Click"
                        Content="⚙" Width="28" Height="28" Margin="4,0,0,0"
                        ToolTip.Tip="Settings"/>
                <TextBlock Name="InfoText" VerticalAlignment="Center" Text="Connecting..."
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- Chat view -->
            <Border Name="ChatBorder" Grid.Row="1"
                    BorderBrush="Gray" BorderThickness="1" Padding="6">
                <ListBox Name="ChatList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Input bar -->
            <Grid Name="ChatInputPanel" Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="ChatInput" Grid.Column="0" KeyDown="ChatInput_KeyDown"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Click="SendChat_Click" Content="Send"/>
            </Grid>
        </Grid>

        <!-- Right sidebar: online users -->
        <StackPanel Grid.Column="2" Margin="8,0,0,0">
            <TextBlock FontWeight="Bold" Margin="0,0,0,4" Text="👥 Online"/>
            <ListBox Name="UsersList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
